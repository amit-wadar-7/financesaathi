# ==============================================================================
# FinanceSaathi (साथी AI) Production Environment Configuration Example
# Copy this file to .env and fill in secure values before deploying.
# ==============================================================================

# 1. Database Configuration
POSTGRES_USER=financesaathi
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=financesaathi
DATABASE_URL=postgresql://financesaathi:your_strong_postgres_password_here@db:5432/financesaathi

# 2. Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 3. Bootstrap System Administrator (Initial Login)
ADMIN_EMAIL=admin@financesaathi.org
ADMIN_PASSWORD=AdminSecurePassword#2026

# 4. Networking & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
APP_ENV=production

# 5. AI / LLM Integration (Optional)
# Options: none | gemini | openai
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
